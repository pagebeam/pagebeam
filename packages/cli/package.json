{
  "name": "pagebeam",
  "version": "0.1.1-rc.1",
  "type": "module",
  "bin": {
    "pagebeam": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE",
    "postpack": "rm -f ./README.md ./LICENSE"
  },
  "license": "MIT",
  "dependencies": {
    "@pagebeam/core": "0.1.1-rc.1",
    "@pagebeam/engine": "0.1.1-rc.1",
    "@pagebeam/git": "0.1.1-rc.1"
  },
  "description": "Docs that keep up with your product",
  "homepage": "https://pagebeam.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagebeam/pagebeam.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "documentation",
    "docs",
    "documentation-drift",
    "docs-as-code",
    "technical-writing",
    "cli"
  ]
