{
  "name": "pagebeam",
  "version": "0.1.3",
  "type": "module",
  "bin": {
    "pagebeam": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
